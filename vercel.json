{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/door-styles.html",
      "destination": "/cabinet-styles.html",
      "permanent": true
    },
    {
      "source": "/door-style-detail.html",
      "has": [
        {
          "type": "query",
          "key": "code",
          "value": "pe"
        }
      ],
      "destination": "/cabinet-styles.html",
      "permanent": true
    },
    {
      "source": "/door-style-detail.html",
      "has": [
        {
          "type": "query",
          "key": "code",
          "value": "ct"
        }
      ],
      "destination": "/cabinet-styles.html",
      "permanent": true
    },
    {
      "source": "/door-style-detail.html",
      "has": [
        {
          "type": "query",
          "key": "code",
          "value": "cs"
        }
      ],
      "destination": "/cabinet-styles.html",
      "permanent": true
    },
    {
      "source": "/door-style-detail.html",
      "has": [
        {
          "type": "query",
          "key": "code",
          "value": "us"
        }
      ],
      "destination": "/cabinet-styles.html",
      "permanent": true
    },
    {
      "source": "/door-style-detail.html",
      "has": [
        {
          "type": "query",
          "key": "code",
          "value": "sm"
        }
      ],
      "destination": "/cabinet-styles.html",
      "permanent": true
    },
    {
      "source": "/door-style-:code(ab|al|cs|ct|ds|nt|pe|sg|sm|so|ss|us).html",
      "destination": "/cabinet-styles.html",
      "permanent": true
    },
    {
      "source": "/door-style-:code(es|gs|ts|ws).html",
      "destination": "/door-style-detail.html?code=:code",
      "permanent": true
    },
    {
      "source": "/:path(.*\\.html)/",
      "destination": "/:path",
      "permanent": true
    }
  ]
}
